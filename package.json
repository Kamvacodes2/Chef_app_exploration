{
  "name": "chefmate-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.3",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "dev": "pnpm --filter @chefmate/web dev",
    "dev:local": "tsx scripts/local-dev.ts",
    "dev:api": "pnpm --filter @chefmate/api dev",
    "dev:worker": "pnpm --filter @chefmate/worker dev",
    "start": "pnpm --filter @chefmate/web start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . && pnpm --filter @chefmate/web lint",
    "typecheck": "tsc -b tsconfig.build.json && tsc -p tsconfig.scripts.json && pnpm --filter @chefmate/web typecheck",
    "build": "tsc -b tsconfig.build.json && pnpm --filter @chefmate/web build",
    "clean": "tsc -b tsconfig.build.json --clean",
    "db:migrate": "tsx scripts/db-migrate.ts migrate",
    "db:migrate:check": "tsx scripts/db-migrate.ts check",
    "db:migrate:status": "tsx scripts/db-migrate.ts status",
    "db:up": "docker compose -f infra/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/docker-compose.yml down -v",
    "test": "pnpm test:unit",
    "test:unit": "vitest run --config vitest.unit.config.ts && pnpm --filter @chefmate/web test:unit",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:security": "vitest run --config vitest.security.config.ts",
    "test:coverage": "vitest run --config vitest.coverage.config.ts --coverage && pnpm --filter @chefmate/web test:coverage",
    "test:e2e": "pnpm --filter @chefmate/web test:e2e",
    "test:a11y": "pnpm --filter @chefmate/web test:a11y",
    "test:ci:quality": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm db:migrate:check && pnpm test:unit && pnpm test:contract && pnpm test:db && pnpm test:integration",
    "test:ci:security": "vitest run --config vitest.security.config.ts --exclude tests/security/dependencies.test.ts --exclude tests/security/devDependencyExceptions.test.ts",
    "test:ci:dependency-audit": "vitest run --config vitest.security.config.ts tests/security/dependencies.test.ts tests/security/devDependencyExceptions.test.ts",
    "test:ci:coverage": "pnpm test:coverage",
    "test:ci:build": "pnpm build",
    "test:ci:playwright": "pnpm test:e2e",
    "test:ci:a11y": "pnpm test:a11y",
    "test:ci": "tsx scripts/ci.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.17.0",
    "jsdom": "^25.0.1",
    "pg": "^8.13.1",
    "prettier": "^3.4.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.10",
    "zod": "^3.24.1"
  }
}
