# Chefmate platform — example environment.
#
# PLACEHOLDERS ONLY. Never commit a real credential to this file or any other
# file in the repository (blueprint invariant 4.3.6). Copy to `.env.local`,
# which is git-ignored, and fill in locally.
#
# Every variable below is validated at process start by `packages/config`.
# A missing or malformed value fails the process immediately rather than
# degrading silently.

# --- shared -----------------------------------------------------------------
# One of: local | test | ci | staging | production
DEPLOY_ENV=local
# One of: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
LOG_PRETTY=false

# --- database ---------------------------------------------------------------
# Standard PostgreSQL connection string. Deliberately vendor-neutral: any
# PostgreSQL 16+ server with PostGIS is acceptable (ADR-0003).
# Local default matches infra/docker-compose.yml.
DATABASE_URL=postgresql://chefmate:CHANGE_ME_LOCAL_ONLY@127.0.0.1:5432/chefmate
# Optional. Set when DDL is owned by a separate, more privileged role than the
# runtime role. Falls back to DATABASE_URL when unset.
# DATABASE_MIGRATION_URL=postgresql://chefmate_migrator:CHANGE_ME_LOCAL_ONLY@127.0.0.1:5432/chefmate
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=15000

# --- api --------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=4000
API_SHUTDOWN_GRACE_MS=10000

# --- worker -----------------------------------------------------------------
WORKER_POLL_INTERVAL_MS=1000
WORKER_BATCH_SIZE=25
WORKER_SHUTDOWN_GRACE_MS=10000

# --- key management ---------------------------------------------------------
# Local/test/ci only. A managed KMS or vault adapter is required for staging and
# production and is selected in S09; `packages/integrations` refuses to start
# with this adapter outside local, test and ci.
KMS_LOCAL_DEV_KEY=CHANGE_ME_LOCAL_ONLY_NOT_A_REAL_KEY

# --- web --------------------------------------------------------------------
# Legacy external API base URL consumed by the browser today. Documented in
# docs/contracts/legacy/README.md; superseded when apps/api serves /api/v1.
NEXT_PUBLIC_CHEFMATE_API_URL=http://127.0.0.1:4000

# --- not configured in S02 --------------------------------------------------
# No provider SDK is a dependency of this repository yet. Paystack, Resend and
# Meta WhatsApp credentials are introduced by S07, S10 and S11 respectively.
